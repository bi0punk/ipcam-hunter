# Plantilla de entorno. Copiar a .env y rellenar (NO commitear .env).
#   cp .example.env .env
# Ninguna credencial real debe vivir en el repositorio: todo se lee de aqui.

# --- Camara (RTSP) ---
# Formato: rtsp://USUARIO:PASSWORD@IP:554/Streaming/Channels/101
# CAM_RTSP_URL tiene prioridad sobre camera.rtsp_url de config.yaml.
CAM_RTSP_URL=
# Substream (menor resolucion). Si se define, tiene prioridad sobre CAM_RTSP_URL.
CAM_RTSP_URL_SUB=
# Stream para el dashboard MJPEG (si vacio, el dashboard no muestra video).
CAM_RTSP_URL_PREVIEW=

# --- ISAPI snapshot HQ (opcional; solo si evidence.mode=isapi) ---
ISAPI_URL=
ISAPI_AUTH=digest
ISAPI_USER=
ISAPI_PASS=

# --- WAHA / WhatsApp ---
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
# chatId del grupo (formato ...@g.us). Requerido.
WAHA_CHAT_ID=

# --- Storage / dashboard ---
EVENTS_DIR=/data/events
CONFIG_PATH=/app/config.yaml

# --- Dashboard MJPEG ---
PREVIEW_WIDTH=640
PREVIEW_FPS=12
JPEG_QUALITY=80
MJPEG_FPS=8
OVERLAY_JSON=/data/events/overlay.json
STATUS_JSON=/data/events/status.json
